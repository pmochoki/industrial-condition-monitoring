# =============================================================================
# Industrial Condition Monitoring Node — Environment Configuration
# Copy to .env and adjust values for your environment.
# Never commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Device identity (simulator or hardware node) ---
DEVICE_ID=machine-001

# --- MQTT (Eclipse Mosquitto or compatible broker) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CLIENT_ID=condition-monitor-001
MQTT_TELEMETRY_INTERVAL_S=1.0

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=sqlite:///./data/telemetry.db

# --- Dashboard (development) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# --- Signal processing defaults (override in config/default.yaml) ---
SAMPLE_RATE_HZ=2048
FFT_WINDOW_SIZE=1024

# --- Alerting (Phase 6+) ---
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false
